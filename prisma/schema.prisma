generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum AdminStatus {
  ENABLED
  DISABLED
}

enum MenuType {
  CATALOG
  MENU
  BUTTON
}

enum MerchantStatus {
  ENABLED
  DISABLED
}

enum CertificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum QualificationType {
  BUSINESS_LICENSE
  FACTORY_AUDIT
  CERTIFICATE
  OTHER
}

enum QualificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SupplyType {
  SPOT
  CUSTOM
  BOTH
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  ON_SHELF
  OFF_SHELF
}

enum ImageType {
  MAIN
  GALLERY
  DETAIL
}

enum OrderStatus {
  PENDING_CONFIRM
  PENDING_PAYMENT
  PENDING_DELIVERY
  SHIPPED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum DeliveryStatus {
  PENDING
  SHIPPED
  RECEIVED
}

enum InquiryStatus {
  SUBMITTED
  ASSIGNED
  CONTACTED
  QUOTED
  CLOSED
  INVALID
}

enum NewsStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Admin {
  id           String           @id @default(cuid())
  username     String           @unique
  passwordHash String
  realName     String?
  phone        String?          @unique
  email        String?          @unique
  status       AdminStatus      @default(ENABLED)
  lastLoginAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  roles        AdminRole[]
  audits       AuditLog[]
  orderLogs    OrderStatusLog[]
}

model Role {
  id          String      @id @default(cuid())
  code        String      @unique
  name        String      @unique
  description String?
  enabled     Boolean     @default(true)
  builtIn     Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  admins      AdminRole[]
  menus       RoleMenu[]
}

model AdminRole {
  adminId String
  roleId  String
  admin   Admin  @relation(fields: [adminId], references: [id], onDelete: Cascade)
  role    Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([adminId, roleId])
}

model Menu {
  id             String     @id @default(cuid())
  parentId       String?
  type           MenuType
  name           String
  path           String?
  component      String?
  icon           String?
  permissionCode String?    @unique
  sortOrder      Int        @default(0)
  visible        Boolean    @default(true)
  enabled        Boolean    @default(true)
  parent         Menu?      @relation("MenuTree", fields: [parentId], references: [id])
  children       Menu[]     @relation("MenuTree")
  roles          RoleMenu[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model RoleMenu {
  roleId String
  menuId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  menu   Menu   @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@id([roleId, menuId])
}

model Merchant {
  id                        String                    @id @default(cuid())
  companyName               String                    @unique
  shortName                 String?
  logo                      String?
  shopId                    String                    @unique @default(cuid())
  logoText                  String?
  themeColor                String?                   @default("blue")
  introduction              String?                   @db.Text
  contactName               String
  contactPhone              String
  province                  String?
  city                      String?
  address                   String?
  mainCategories            Json?
  mainProducts              Json?
  mainProductKeywords       Json?
  businessYears             Int?
  responseRate              Int?
  deliveryLocation          String?
  supportsCustomization     Boolean                   @default(false)
  status                    MerchantStatus            @default(ENABLED)
  certificationStatus       CertificationStatus       @default(PENDING)
  certificationRemark       String?
  companyType               String?
  businessStatus            String?                   @default("active")
  legalRepresentative       String?
  registeredCapital         Decimal?                  @db.Decimal(14, 2)
  registeredCapitalCurrency String?                   @default("CNY") @db.Char(3)
  establishedAt             DateTime?                 @db.Date
  businessTermStart         DateTime?                 @db.Date
  businessTermEnd           DateTime?                 @db.Date
  businessScope             String?                   @db.Text
  registrationAuthority     String?
  unifiedSocialCreditCode   String?                   @unique @db.Char(18)
  organizationCode          String?
  taxpayerId                String?
  registrationNumber        String?
  websiteUrl                String?
  sortOrder                 Int                       @default(0)
  viewCount                 BigInt                    @default(0)
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  qualifications            MerchantQualification[]
  contacts                  MerchantContact[]
  shippingAddresses         MerchantShippingAddress[]
  verifications             MerchantVerification[]
  products                  Product[]
  orders                    PurchaseOrder[]
  inquiries                 Inquiry[]
}

model MerchantContact {
  id             String   @id @default(cuid())
  merchantId     String
  name           String
  mobile         String
  telephone      String?
  email          String?
  position       String?
  isPrimary      Boolean  @default(false)
  visibleToBuyer Boolean  @default(false)
  merchant       Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model MerchantShippingAddress {
  id                       String   @id @default(cuid())
  merchantId               String
  provinceCode             String
  cityCode                 String
  districtCode             String
  addressDetail            String
  isDefaultShippingAddress Boolean  @default(false)
  merchant                 Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model MerchantVerification {
  id                 String    @id @default(cuid())
  merchantId         String
  verificationType   String
  verificationStatus String    @default("PENDING")
  verifiedAt         DateTime?
  expiresAt          DateTime?
  documentUrls       Json?
  remark             String?   @db.Text
  merchant           Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([merchantId, verificationType])
}

model MerchantQualification {
  id           String              @id @default(cuid())
  merchantId   String
  type         QualificationType
  url          String
  status       QualificationStatus @default(PENDING)
  remark       String?
  reviewedById String?
  reviewedAt   DateTime?
  merchant     Merchant            @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model Category {
  id                 String              @id @default(cuid())
  parentId           String?
  name               String
  icon               String?
  sortOrder          Int                 @default(0)
  level              Int
  enabled            Boolean             @default(true)
  parent             Category?           @relation("CategoryTree", fields: [parentId], references: [id])
  children           Category[]          @relation("CategoryTree")
  products           Product[]
  procurementDemands ProcurementDemand[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([parentId, name])
}

model Product {
  id                   String              @id @default(cuid())
  merchantId           String
  categoryId           String
  name                 String
  spuCode              String?             @unique
  brand                String?
  model                String?
  manufacturer         String?
  originPlace          String?
  shortDescription     String?
  detailContent        String?             @db.LongText
  mainImage            String?
  imageUrls            Json?
  videoUrls            Json?
  marketingBadge       String?
  sellingPoints        Json?
  supplyMethods        Json?
  applicationScenarios Json?
  serviceGuarantees    Json?
  afterSalesService    String?             @db.Text
  technicalParameters  Json?
  featureTags          Json?
  customizationEnabled Boolean             @default(false)
  inquiryEnabled       Boolean             @default(true)
  unit                 String              @default("件")
  shipWithinHours      Int?
  searchKeywords       Json?
  sortOrder            Int                 @default(0)
  salesCount           Int                 @default(0)
  viewCount            BigInt              @default(0)
  publishedAt          DateTime?
  supplyType           SupplyType          @default(SPOT)
  deliveryDays         Int?
  minOrderQuantity     Decimal             @default(1) @db.Decimal(12, 3)
  status               ProductStatus       @default(DRAFT)
  rejectionReason      String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  deletedAt            DateTime?
  merchant             Merchant            @relation(fields: [merchantId], references: [id])
  category             Category            @relation(fields: [categoryId], references: [id])
  skus                 ProductSku[]
  images               ProductImage[]
  orderItems           PurchaseOrderItem[]
  inquiries            Inquiry[]

  @@index([status, categoryId])
}

model ProductSku {
  id               String              @id @default(cuid())
  productId        String
  specName         String
  specValue        String
  specValues       Json?
  imageUrl         String?
  skuCode          String              @unique
  priceCent        Int
  minOrderQuantity Decimal             @default(1) @db.Decimal(12, 3)
  stockQuantity    Decimal             @default(0) @db.Decimal(14, 3)
  enabled          Boolean             @default(true)
  priceCurrency    String              @default("CNY") @db.Char(3)
  priceUnit        String              @default("件")
  priceFrom        Boolean             @default(false)
  stockStatus      String              @default("in_stock")
  tierPrices       SkuTierPrice[]
  product          Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems       PurchaseOrderItem[]
  inquiries        Inquiry[]
}

model SkuTierPrice {
  id          String     @id @default(cuid())
  skuId       String
  minQuantity Decimal    @db.Decimal(12, 3)
  maxQuantity Decimal?   @db.Decimal(12, 3)
  unitPrice   Decimal    @db.Decimal(14, 2)
  currency    String     @default("CNY") @db.Char(3)
  sku         ProductSku @relation(fields: [skuId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([skuId, minQuantity])
}

model Inquiry {
  id                  String        @id @default(cuid())
  merchantId          String
  productId           String?
  skuId               String?
  productNameSnapshot String
  requirement         String        @db.VarChar(300)
  expectedSpec        String?       @db.VarChar(500)
  quantity            Decimal?      @db.Decimal(12, 3)
  unit                String?       @db.VarChar(20)
  expectedDeliveryAt  DateTime?     @db.Date
  contactName         String        @db.VarChar(80)
  contactPhone        String        @db.VarChar(32)
  contactEmail        String?       @db.VarChar(120)
  status              InquiryStatus @default(SUBMITTED)
  handlerId           String?
  handledAt           DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  merchant            Merchant      @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  product             Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  sku                 ProductSku?   @relation(fields: [skuId], references: [id], onDelete: SetNull)

  @@index([merchantId, status, createdAt])
  @@index([productId])
}

model ProcurementDemand {
  id           String   @id @default(cuid())
  categoryId   String
  description  String   @db.VarChar(1000)
  quantity     Decimal  @db.Decimal(12, 3)
  unit         String   @db.VarChar(20)
  contactName  String   @db.VarChar(80)
  contactPhone String   @db.VarChar(32)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  category     Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([categoryId, createdAt])
}

model NewsArticle {
  id          String     @id @default(cuid())
  title       String     @db.VarChar(200)
  summary     String     @db.VarChar(500)
  coverImage  String?
  content     String     @db.LongText
  publishedAt DateTime?
  viewCount   Int        @default(0)
  status      NewsStatus @default(DRAFT)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status, publishedAt])
}

model ProductImage {
  id        String    @id @default(cuid())
  productId String
  url       String
  type      ImageType @default(GALLERY)
  sortOrder Int       @default(0)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model PurchaseOrder {
  id                String              @id @default(cuid())
  orderNo           String              @unique
  buyerCompanyName  String
  buyerContactName  String
  buyerContactPhone String
  merchantId        String
  totalAmountCent   Int
  orderStatus       OrderStatus         @default(PENDING_CONFIRM)
  paymentStatus     PaymentStatus       @default(UNPAID)
  deliveryStatus    DeliveryStatus      @default(PENDING)
  receiverName      String
  receiverPhone     String
  receiverAddress   String
  remark            String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  merchant          Merchant            @relation(fields: [merchantId], references: [id])
  items             PurchaseOrderItem[]
  logs              OrderStatusLog[]
}

model PurchaseOrderItem {
  id                    String        @id @default(cuid())
  orderId               String
  productId             String
  skuId                 String?
  productNameSnapshot   String
  productImageSnapshot  String?
  skuNameSnapshot       String?
  unitPriceCentSnapshot Int
  quantity              Int
  subtotalCent          Int
  order                 PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product               Product       @relation(fields: [productId], references: [id])
  sku                   ProductSku?   @relation(fields: [skuId], references: [id])
}

model OrderStatusLog {
  id              String        @id @default(cuid())
  orderId         String
  fromStatus      OrderStatus?
  toStatus        OrderStatus
  operatorAdminId String?
  remark          String?
  createdAt       DateTime      @default(now())
  order           PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  operatorAdmin   Admin?        @relation(fields: [operatorAdminId], references: [id])
}

model AuditLog {
  id           String   @id @default(cuid())
  adminId      String?
  action       String
  resourceType String
  resourceId   String?
  detail       Json?
  ip           String?
  createdAt    DateTime @default(now())
  admin        Admin?   @relation(fields: [adminId], references: [id])

  @@index([resourceType, resourceId])
}
